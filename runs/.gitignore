# Large or regenerable outputs stay on the machine that made them (see runs/_handoff/README.md)
*.mp4
*.jpg
*.png
*.log
*.npz
__pycache__/

# envkit's frozen scenes: large binary state dumps, rebuilt by envkit/tests/campaign.sh (their .ref.json stay in git)
envkit/scenes/*.pkl.gz

# envkit policy-test records (actions and tracker per chunk; binary, rebuilt by envkit/tests/policy_tests.sh)
envkit/tests/results/policy/
